APP_ADDR=:8080
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174
PROVIDER_HTTP_REFERER=http://localhost:5173
PROVIDER_APP_TITLE=Career Pilot

# Web bundle's API base. Leave empty for docker (nginx proxies /api same-origin).
# For host-dev (vite dev server), set to http://localhost:8080 to hit pyapi directly.
VITE_API_BASE_URL=

DATABASE_URL=postgresql://careerpilot:careerpilot@localhost:5432/careerpilot
POSTGRES_PORT=5432

# Providers (openrouter,huggingface)
DEFAULT_CHAT_PROVIDER=openrouter


# Providers keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
HUGGINGFACE_API_KEY=
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1

# Models
#CHAT_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Per-agent LLM overrides. Format: provider|:model (e.g. openrouter|:openrouter/owl-alpha:free).
# Leave blank to fall back to DEFAULT_CHAT_PROVIDER + CHAT_MODEL.
ORCHESTRATOR_LLM=openrouter|:nvidia/nemotron-3-super-120b-a12b:free
RESUME_TAILOR_LLM=openrouter|:nvidia/nemotron-3-super-120b-a12b:free
JOB_SCOUT_LLM=openrouter|:nvidia/nemotron-3-super-120b-a12b:free
APPLIER_LLM=openrouter|:nvidia/nemotron-3-super-120b-a12b:free
TRACKER_LLM=openrouter|:nvidia/nemotron-3-super-120b-a12b:free
CONTEXT_SUMMARIZER_LLM=openrouter|:nvidia/nemotron-3-super-120b-a12b:free
SCRAPE_DATA_SUMMARIZER_LLM=openrouter|:nvidia/nemotron-3-super-120b-a12b:free


# Context
# Max tokens the chat model may return.
MAX_RESPONSE_TOKENS=20000
# Max recent messages sent to the LLM each turn.
MAX_HISTORY_MESSAGES=30
# Max characters of the memory block injected into the system prompt per call.
MAX_MEMORY_CHARS=2000
# Min seconds between any two provider LLM calls (process-global). 0 = off.
# Bump to 1.0–3.0 when using free-tier models that rate-limit aggressively.
LLM_CALL_THROTTLE_SECONDS=1.0

# Read-only assistant tools for local project inspection.
TOOLS_ENABLED=true
# Relative paths are resolved from this .env file location.
TOOL_WORKSPACE_ROOT=.
# Max tool calls an assistant answer may make before returning a final response.
MAX_TOOL_ITERATIONS=3
# Max characters returned from each tool result.
MAX_TOOL_OUTPUT_CHARS=12000
# Allow read-only public web tools: fetch_url, read_llms_txt, crawl_site.
INTERNET_TOOLS_ENABLED=true
# HTTP timeout for read-only internet tools.
TOOL_NETWORK_TIMEOUT_SECONDS=10
# Max bytes read per fetched URL.
MAX_TOOL_NETWORK_BYTES=300000
# Max same-site pages crawl_site may fetch.
TOOL_CRAWL_MAX_PAGES=5

